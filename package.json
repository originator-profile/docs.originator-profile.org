{
  "name": "@originator-profile/docs",
  "description": "Originator Profile Documentation",
  "homepage": "https://docs.originator-profile.org",
  "repository": "https://github.com/originator-profile/docs.originator-profile.org",
  "private": true,
  "scripts": {
    "format": "prettier --write .",
    "check": "scripts/check-numbering.js && scripts/check-original-commits.js",
    "build": "git fetch --unshallow; docusaurus build --out-dir pages && node copy-aov.mjs && node copy-public.mjs",
    "preview": "node copy-aov.mjs; docusaurus start"
  },
  "devDependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/faster": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "0.55.2",
    "@r74tech/docusaurus-plugin-panzoom": "2.4.2",
    "@types/shelljs": "0.10.0",
    "dedent": "1.7.2",
    "docusaurus-plugin-image-zoom": "3.0.1",
    "gray-matter": "4.0.3",
    "prettier": "3.9.1",
    "shelljs": "0.10.0"
  },
  "packageManager": "pnpm@11.9.0"
}
